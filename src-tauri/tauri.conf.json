{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shed",
  "version": "0.1.0",
  "identifier": "app.shed.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Shed",
        "width": 1020,
        "height": 700,
        "minWidth": 760,
        "minHeight": 520,
        "center": true,
        "visible": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Right-click a folder to clean build output and AI-tool leftovers.",
    "longDescription": "Shed finds what your projects and AI coding agents leave behind (node_modules, target, .next, virtualenvs, old agent downloads, download caches) and moves it to the Trash after you check the list. Right-click any folder in Finder or Explorer. Everything runs offline and every clean can be undone.",
    "copyright": "MIT License",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "files": {
        "Resources/en.lproj/ServicesMenu.strings": "./macos/en.lproj/ServicesMenu.strings",
        "Resources/zh-Hans.lproj/ServicesMenu.strings": "./macos/zh-Hans.lproj/ServicesMenu.strings"
      }
    },
    "windows": {
      "nsis": { "installerHooks": "./windows/hooks.nsh" }
    }
  }
}
